#!/bin/bash

# macssh - a tiny host manager built on top of macOS OpenSSH.
set -u

VERSION="0.5.0"
SSH_HOME="${MACSSH_HOME:-$HOME/.ssh}"
CONFIG_FILE="${MACSSH_CONFIG:-$SSH_HOME/config.d/macssh.conf}"
MAIN_CONFIG="${MACSSH_MAIN_CONFIG:-$SSH_HOME/config}"
LOG_DIR="${MACSSH_LOG_DIR:-$HOME/ssh-logs}"
TUNNEL_DIR="${MACSSH_TUNNEL_DIR:-$SSH_HOME/macssh-tunnels}"

die() {
  printf 'macssh: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat <<'EOF'
Usage:
  macssh                         Select and connect to a host
  macssh add [name] [options]    Add or update a host
  macssh list                    List managed hosts
  macssh connect [name] [--log]  Connect to a host
  macssh tunnel [start] <name> <remote-port> [--local LOCAL_PORT] [--bind ADDRESS]
                                Start a background local port tunnel
  macssh tunnel list             List active tunnels
  macssh tunnel stop <name> <local-port>
                                Stop a tunnel
  macssh tunnel stop --all       Stop all managed tunnels
  macssh test <name>             Test authentication
  macssh put <name> <local> [remote]
                                Upload a file or folder
  macssh get <name> <remote> [local]
                                Download a file or folder
  macssh edit <name>             Edit a host interactively
  macssh remove <name>           Remove a host
  macssh config                  Open the managed SSH config
  macssh path                    Print the managed SSH config path

Add options:
  --host HOST     Hostname or IP address
  --user USER     SSH username
  --port PORT     SSH port (default: 22)
  --key PATH      Identity file path
  --jump HOST     ProxyJump host alias
  --tags TEXT     Comma-separated tags or a note
  --yes           Replace an existing host without confirmation

Connect options:
  --log           Save a readable session log to ~/ssh-logs

Tunnel options:
  --local PORT    Local port (default: same as remote port)
  --bind ADDRESS  Local IPv4 address to listen on (default: 127.0.0.1)
  --compress      Enable SSH compression
EOF
}

init_config() {
  local config_dir include_line
  config_dir=$(dirname "$CONFIG_FILE")
  mkdir -p "$SSH_HOME" "$config_dir" || die "cannot create $config_dir"
  chmod 700 "$SSH_HOME" "$config_dir" 2>/dev/null || true
  if [ ! -e "$CONFIG_FILE" ]; then
    : > "$CONFIG_FILE" || die "cannot create $CONFIG_FILE"
  fi
  chmod 600 "$CONFIG_FILE" 2>/dev/null || true
  if [ ! -s "$CONFIG_FILE" ]; then
    printf '%s\n' 'IgnoreUnknown UseKeychain' > "$CONFIG_FILE" || die "cannot initialize $CONFIG_FILE"
  fi

  # Only install an Include when using the default location. Custom paths are
  # intended for tests and advanced callers.
  if [ -z "${MACSSH_CONFIG:-}" ]; then
    touch "$MAIN_CONFIG" || die "cannot create $MAIN_CONFIG"
    chmod 600 "$MAIN_CONFIG" 2>/dev/null || true
    include_line="Include ~/.ssh/config.d/*.conf"
    if ! grep -Fqx "$include_line" "$MAIN_CONFIG" 2>/dev/null; then
      {
        [ ! -s "$MAIN_CONFIG" ] || printf '\n'
        printf '%s\n' "$include_line"
      } >> "$MAIN_CONFIG" || die "cannot update $MAIN_CONFIG"
    fi
  fi
}

validate_name() {
  case "$1" in
    ''|*[!A-Za-z0-9._-]*) die "host name may contain only letters, numbers, dot, underscore, and dash" ;;
  esac
}

validate_value() {
  case "$2" in
    *$'\n'*|*$'\r'*) die "$1 must be a single line" ;;
  esac
}

validate_port() {
  case "$1" in ''|*[!0-9]*) die "port must be a number" ;; esac
  [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null || die "port must be between 1 and 65535"
}

validate_ipv4() {
  local address="$1" part rest count=0
  case "$address" in
    ''|.*|*.|*..*|*[!0-9.]*) die "bind address must be an IPv4 address" ;;
  esac
  rest="$address"
  while :; do
    case "$rest" in
      *.*) part=${rest%%.*}; rest=${rest#*.} ;;
      *) part=$rest; rest="" ;;
    esac
    case "$part" in ''|*[!0-9]*) die "bind address must be an IPv4 address" ;; esac
    [ "$part" -le 255 ] 2>/dev/null || die "bind address must be an IPv4 address"
    count=$((count + 1))
    [ -n "$rest" ] || break
  done
  [ "$count" -eq 4 ] || die "bind address must be an IPv4 address"
}

init_tunnel_dir() {
  mkdir -p "$TUNNEL_DIR" || die "cannot create $TUNNEL_DIR"
  chmod 700 "$TUNNEL_DIR" 2>/dev/null || true
}

tunnel_state_file() {
  printf '%s/%s-%s.state' "$TUNNEL_DIR" "$1" "$2"
}

tunnel_control_file() {
  printf '%s/%s-%s.sock' "$TUNNEL_DIR" "$1" "$2"
}

tunnel_is_running() {
  ssh -S "$2" -O check "$1" >/dev/null 2>&1
}

read_tunnel_state() {
  TUNNEL_NAME=$(sed -n '1p' "$1")
  TUNNEL_LOCAL_PORT=$(sed -n '2p' "$1")
  TUNNEL_REMOTE_PORT=$(sed -n '3p' "$1")
  TUNNEL_CONTROL=$(sed -n '4p' "$1")
  TUNNEL_BIND_ADDRESS=$(sed -n '5p' "$1")
  TUNNEL_BIND_ADDRESS=${TUNNEL_BIND_ADDRESS:-127.0.0.1}
  [ -n "$TUNNEL_NAME" ] && [ -n "$TUNNEL_LOCAL_PORT" ] \
    && [ -n "$TUNNEL_REMOTE_PORT" ] && [ -n "$TUNNEL_CONTROL" ]
}

host_exists() {
  [ -f "$CONFIG_FILE" ] && awk -v wanted="$1" '$1 == "Host" && $2 == wanted { found=1 } END { exit !found }' "$CONFIG_FILE"
}

get_value() {
  awk -v wanted="$1" -v key="$2" '
    $1 == "Host" { inside=($2 == wanted); next }
    inside && $1 == key {
      sub(/^[[:space:]]*[^[:space:]]+[[:space:]]+/, "")
      print
      exit
    }
  ' "$CONFIG_FILE" 2>/dev/null
}

get_tags() {
  awk -v wanted="$1" '
    $1 == "Host" { inside=($2 == wanted); next }
    inside && /^[[:space:]]*#[[:space:]]*Tags:/ {
      sub(/^[[:space:]]*#[[:space:]]*Tags:[[:space:]]*/, "")
      print
      exit
    }
  ' "$CONFIG_FILE" 2>/dev/null
}

remove_block() {
  local name="$1" tmp
  tmp=$(mktemp "${CONFIG_FILE}.XXXXXX") || die "cannot create temporary file"
  awk -v wanted="$name" '
    $1 == "Host" {
      if ($2 == wanted) { skip=1; next }
      skip=0
    }
    !skip { print }
  ' "$CONFIG_FILE" > "$tmp" || { rm -f "$tmp"; die "cannot rewrite config"; }
  chmod 600 "$tmp" 2>/dev/null || true
  mv "$tmp" "$CONFIG_FILE" || { rm -f "$tmp"; die "cannot replace config"; }
}

prompt_default() {
  local label="$1" default_value="$2" answer
  if [ -n "$default_value" ]; then
    printf '%s [%s]: ' "$label" "$default_value" >&2
  else
    printf '%s: ' "$label" >&2
  fi
  IFS= read -r answer || true
  printf '%s' "${answer:-$default_value}"
}

quote_ssh_value() {
  # OpenSSH accepts double-quoted arguments; backslash and quote are escaped.
  printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/^/"/; s/$/"/'
}

write_host() {
  local name="$1" hostname="$2" user="$3" port="$4" key="$5" jump="$6" tags="$7"
  {
    [ ! -s "$CONFIG_FILE" ] || printf '\n'
    printf 'Host %s\n' "$name"
    printf '    HostName %s\n' "$(quote_ssh_value "$hostname")"
    [ -z "$user" ] || printf '    User %s\n' "$(quote_ssh_value "$user")"
    printf '    Port %s\n' "$port"
    if [ -n "$key" ]; then
      printf '    IdentityFile %s\n' "$(quote_ssh_value "$key")"
      printf '    IdentitiesOnly yes\n'
      printf '    AddKeysToAgent yes\n'
      printf '    UseKeychain yes\n'
    fi
    [ -z "$jump" ] || printf '    ProxyJump %s\n' "$(quote_ssh_value "$jump")"
    printf '    ServerAliveInterval 30\n'
    printf '    ServerAliveCountMax 3\n'
    [ -z "$tags" ] || printf '    # Tags: %s\n' "$tags"
  } >> "$CONFIG_FILE" || die "cannot write $CONFIG_FILE"
}

cmd_add() {
  init_config
  local name="" hostname="" user="" port="22" key="" jump="" tags="" assume_yes=0 interactive=0 force_interactive=0
  if [ $# -gt 0 ] && [ "${1#--}" = "$1" ]; then name="$1"; shift; fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --host|--user|--port|--key|--jump|--tags)
        [ $# -ge 2 ] || die "$1 requires a value"
        case "$1" in
          --host) hostname="$2" ;; --user) user="$2" ;; --port) port="$2" ;;
          --key) key="$2" ;; --jump) jump="$2" ;; --tags) tags="$2" ;;
        esac
        shift 2 ;;
      --yes) assume_yes=1; shift ;;
      --interactive) interactive=1; force_interactive=1; shift ;;
      *) die "unknown option: $1" ;;
    esac
  done

  [ -n "$name" ] || { name=$(prompt_default "Name" ""); interactive=1; }
  validate_name "$name"
  if host_exists "$name"; then
    [ -n "$hostname" ] || hostname=$(get_value "$name" HostName)
    [ -n "$user" ] || user=$(get_value "$name" User)
    [ "$port" != "22" ] || port=$(get_value "$name" Port); port=${port:-22}
    [ -n "$key" ] || key=$(get_value "$name" IdentityFile); key=${key#\"}; key=${key%\"}
    [ -n "$jump" ] || jump=$(get_value "$name" ProxyJump); jump=${jump#\"}; jump=${jump%\"}
    [ -n "$tags" ] || tags=$(get_tags "$name")
    if [ "$assume_yes" -ne 1 ] && [ "$interactive" -ne 1 ]; then
      printf "Host '%s' exists. Replace it? [y/N] " "$name" >&2
      IFS= read -r reply || true
      case "$reply" in y|Y|yes|YES) ;; *) die "cancelled" ;; esac
    fi
  fi

  if [ -z "$hostname" ]; then hostname=$(prompt_default "Hostname or IP" ""); interactive=1; fi
  if [ "$interactive" -eq 1 ]; then
    if [ "$force_interactive" -eq 1 ]; then hostname=$(prompt_default "Hostname or IP" "$hostname"); fi
    user=$(prompt_default "User" "$user")
    port=$(prompt_default "Port" "$port")
    key=$(prompt_default "Private key path (optional)" "$key")
    jump=$(prompt_default "ProxyJump host (optional)" "$jump")
    tags=$(prompt_default "Tags/note (optional)" "$tags")
  fi
  [ -n "$hostname" ] || die "hostname is required"
  validate_port "$port"
  validate_value hostname "$hostname"; validate_value user "$user"; validate_value key "$key"
  validate_value jump "$jump"; validate_value tags "$tags"
  host_exists "$name" && remove_block "$name"
  write_host "$name" "$hostname" "$user" "$port" "$key" "$jump" "$tags"
  printf "Saved '%s'. Connect with: macssh connect %s\n" "$name" "$name"
}

cmd_list() {
  init_config
  printf '%-22s %-28s %-16s %-6s %s\n' NAME HOST USER PORT TAGS
  awk '
    function emit() {
      if (name != "") printf "%-22s %-28s %-16s %-6s %s\n", name, host, user, port, tags
    }
    $1 == "Host" { emit(); name=$2; host=""; user=""; port="22"; tags=""; next }
    name != "" && $1 == "HostName" { host=$2; gsub(/^"|"$/, "", host); next }
    name != "" && $1 == "User" { user=$2; gsub(/^"|"$/, "", user); next }
    name != "" && $1 == "Port" { port=$2; next }
    name != "" && /^[[:space:]]*#[[:space:]]*Tags:/ {
      line=$0; sub(/^[[:space:]]*#[[:space:]]*Tags:[[:space:]]*/, "", line); tags=line
    }
    END { emit() }
  ' "$CONFIG_FILE"
}

select_host() {
  local names=() name choice i=1
  while IFS= read -r name; do [ -n "$name" ] && names[${#names[@]}]="$name"; done < <(awk '$1 == "Host" { print $2 }' "$CONFIG_FILE")
  [ ${#names[@]} -gt 0 ] || die "no hosts configured; run: macssh add"
  for name in "${names[@]}"; do printf '%3d) %s\n' "$i" "$name" >&2; i=$((i + 1)); done
  printf 'Select host: ' >&2
  IFS= read -r choice || true
  case "$choice" in ''|*[!0-9]*) die "invalid selection" ;; esac
  [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le ${#names[@]} ] 2>/dev/null || die "invalid selection"
  printf '%s' "${names[$((choice - 1))]}"
}

resolve_host() {
  init_config
  local name="${1:-}"
  [ -n "$name" ] || name=$(select_host)
  host_exists "$name" || die "unknown host: $name"
  printf '%s' "$name"
}

write_readable_log() {
  local raw="$1" log="$2" cleaned cols rows
  cleaned=$(mktemp "${TMPDIR:-/tmp}/macssh.XXXXXX") || die "cannot create temporary log"
  cols=$(stty size 2>/dev/null | awk '{print $2}')
  rows=$(stty size 2>/dev/null | awk '{print $1}')
  cols=${cols:-${COLUMNS:-80}}
  rows=${rows:-${LINES:-24}}
  # Replay the recorded PTY as a screen so full-screen TUIs collapse to the
  # last visible frame instead of concatenating every cursor move.
  if ! MACSSH_COLS="$cols" MACSSH_ROWS="$rows" perl - "$raw" > "$cleaned" <<'PERL'
use strict;
use warnings;
use Encode qw(decode);
binmode STDOUT, ':encoding(UTF-8)';

my $raw = do { local $/; open my $fh, '<:raw', $ARGV[0] or die $!; <$fh> };
$raw = '' unless defined $raw;
my $buf = decode('UTF-8', $raw, Encode::FB_DEFAULT);
$buf =~ s/\r\n/\n/g;
$buf =~ s/^Script started on [^\n]*\n//;
$buf =~ s/\nScript done on [^\n]*\z//;

my $cols = 0 + ($ENV{MACSSH_COLS} || $ENV{COLUMNS} || 80);
my $rows = 0 + ($ENV{MACSSH_ROWS} || $ENV{LINES} || 24);
$cols = 80 if $cols < 20;
$cols = 400 if $cols > 400;
$rows = 24 if $rows < 5;
$rows = 200 if $rows > 200;

sub blank_row { [ (' ') x $cols ] }
sub clone_row { [ @{$_[0]} ] }
sub clone_screen { [ map { clone_row($_) } @{$_[0]} ] }

my @screen = map { blank_row() } 1 .. $rows;
my @history;
my ($crow, $ccol) = (0, 0);
my ($saved_row, $saved_col) = (0, 0);
my $alt = 0;
my @pri_screen;
my @pri_history;
my ($pri_row, $pri_col) = (0, 0);

sub row_text {
    my ($r) = @_;
    my $s = join('', map { (defined $_ && $_ ne '') ? $_ : ' ' } @$r);
    $s =~ s/ +\z//;
    return $s;
}

sub screen_lines {
    my @lines = map { row_text($_) } @screen;
    while (@lines && $lines[-1] eq '') { pop @lines }
    return @lines;
}

sub commit_screen {
    my @lines = screen_lines();
    push @history, @lines if @lines;
}

sub chwidth {
    my $o = ord($_[0]);
    return 0 if $o < 32;
    return 2 if $o >= 0x1100 && (
        $o <= 0x115F || $o == 0x2329 || $o == 0x232A
        || ($o >= 0x2E80 && $o <= 0xA4CF && $o != 0x303F)
        || ($o >= 0xAC00 && $o <= 0xD7A3)
        || ($o >= 0xF900 && $o <= 0xFAFF)
        || ($o >= 0xFE10 && $o <= 0xFE19)
        || ($o >= 0xFE30 && $o <= 0xFE6F)
        || ($o >= 0xFF00 && $o <= 0xFF60)
        || ($o >= 0xFFE0 && $o <= 0xFFE6)
        || ($o >= 0x1F300)
    );
    return 1;
}

sub clamp_cursor {
    $crow = 0 if $crow < 0;
    $crow = $rows - 1 if $crow >= $rows;
    $ccol = 0 if $ccol < 0;
    $ccol = $cols - 1 if $ccol >= $cols;
}

sub scroll_up {
    push @history, row_text($screen[0]);
    shift @screen;
    push @screen, blank_row();
}

sub newline {
    $ccol = 0;
    if ($crow >= $rows - 1) {
        scroll_up();
        $crow = $rows - 1;
    } else {
        $crow++;
    }
}

sub put {
    my ($ch) = @_;
    my $w = chwidth($ch);
    return if $w <= 0;
    if ($ccol + $w > $cols) { newline(); }
    if ($ccol > 0 && defined $screen[$crow][$ccol] && $screen[$crow][$ccol] eq '') {
        $screen[$crow][$ccol - 1] = ' ' if $ccol - 1 >= 0;
    }
    $screen[$crow][$ccol] = $ch;
    if ($w == 2 && $ccol + 1 < $cols) {
        $screen[$crow][$ccol + 1] = '';
    }
    $ccol += $w;
    $ccol = $cols if $ccol > $cols;
}

sub erase_cells {
    my ($r, $from, $to) = @_;
    $from = 0 if $from < 0;
    $to = $cols - 1 if $to >= $cols;
    return if $to < $from;
    for my $i ($from .. $to) { $screen[$r][$i] = ' '; }
}

sub enter_alt {
    return if $alt;
    @pri_screen = @{ clone_screen(\@screen) };
    @pri_history = @history;
    ($pri_row, $pri_col) = ($crow, $ccol);
    @screen = map { blank_row() } 1 .. $rows;
    @history = ();
    ($crow, $ccol) = (0, 0);
    $alt = 1;
}

sub leave_alt {
    return unless $alt;
    commit_screen();
    my @alt_hist = @history;
    @screen = @pri_screen ? @{ clone_screen(\@pri_screen) } : map { blank_row() } 1 .. $rows;
    @history = (@pri_history, @alt_hist);
    ($crow, $ccol) = ($pri_row, $pri_col);
    $alt = 0;
    clamp_cursor();
}

sub csi {
    my ($params, $inter, $final) = @_;
    return if $inter ne '';
    my $private = ($params =~ s/^([?<=>])//) ? $1 : '';
    my @p = map {
        (!defined $_ || $_ eq '' || $_ !~ /^\d+\z/) ? undef : 0 + $_
    } split /;/, $params, -1;
    my $n = (defined $p[0] && $p[0] > 0) ? $p[0] : 0;
    my $n1 = $n || 1;

    if ($private ne '' && ($final eq 'h' || $final eq 'l')) {
        my $on = $final eq 'h';
        for my $mode (@p) {
            next unless defined $mode;
            if ($mode == 1049 || $mode == 47 || $mode == 1047) {
                $on ? enter_alt() : leave_alt();
            }
        }
        return;
    }
    return if $private ne '';

    if ($final eq 'A') { $crow -= $n1; clamp_cursor(); }
    elsif ($final eq 'B') { $crow += $n1; clamp_cursor(); }
    elsif ($final eq 'C') { $ccol += $n1; clamp_cursor(); }
    elsif ($final eq 'D') { $ccol -= $n1; clamp_cursor(); }
    elsif ($final eq 'E') { $crow += $n1; $ccol = 0; clamp_cursor(); }
    elsif ($final eq 'F') { $crow -= $n1; $ccol = 0; clamp_cursor(); }
    elsif ($final eq 'G') { $ccol = ($n || 1) - 1; clamp_cursor(); }
    elsif ($final eq 'd') { $crow = ($n || 1) - 1; clamp_cursor(); }
    elsif ($final eq 'H' || $final eq 'f') {
        my $r = (defined $p[0] && $p[0] > 0) ? $p[0] : 1;
        my $c = (defined $p[1] && $p[1] > 0) ? $p[1] : 1;
        $crow = $r - 1;
        $ccol = $c - 1;
        clamp_cursor();
    }
    elsif ($final eq 'J') {
        my $m = defined $p[0] ? $p[0] : 0;
        if ($m == 2 || $m == 3) {
            @screen = map { blank_row() } 1 .. $rows;
        } elsif ($m == 1) {
            erase_cells($crow, 0, $ccol);
            for my $r (0 .. $crow - 1) { $screen[$r] = blank_row(); }
        } else {
            erase_cells($crow, $ccol, $cols - 1);
            for my $r ($crow + 1 .. $rows - 1) { $screen[$r] = blank_row(); }
        }
    }
    elsif ($final eq 'K') {
        my $m = defined $p[0] ? $p[0] : 0;
        if ($m == 2) { $screen[$crow] = blank_row(); }
        elsif ($m == 1) { erase_cells($crow, 0, $ccol); }
        else { erase_cells($crow, $ccol, $cols - 1); }
    }
    elsif ($final eq 's') { ($saved_row, $saved_col) = ($crow, $ccol); }
    elsif ($final eq 'u') { ($crow, $ccol) = ($saved_row, $saved_col); clamp_cursor(); }
}

pos($buf) = 0;
while (defined pos($buf) && pos($buf) < length($buf)) {
    if ($buf =~ /\G\n/gc) { newline(); }
    elsif ($buf =~ /\G\r/gc) { $ccol = 0; }
    elsif ($buf =~ /\G\x08/gc) { $ccol-- if $ccol > 0; }
    elsif ($buf =~ /\G\t/gc) {
        $ccol += 8 - ($ccol % 8);
        $ccol = $cols - 1 if $ccol >= $cols;
    }
    elsif ($buf =~ /\G[\x00-\x07\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]/gc) { }
    elsif ($buf =~ /\G\e7/gc) { ($saved_row, $saved_col) = ($crow, $ccol); }
    elsif ($buf =~ /\G\e8/gc) { ($crow, $ccol) = ($saved_row, $saved_col); clamp_cursor(); }
    elsif ($buf =~ /\G\eM/gc) {
        if ($crow > 0) { $crow--; }
        else { pop @screen; unshift @screen, blank_row(); }
    }
    elsif ($buf =~ /\G\eD/gc) {
        if ($crow >= $rows - 1) { scroll_up(); }
        else { $crow++; }
    }
    elsif ($buf =~ /\G\eE/gc) { newline(); }
    elsif ($buf =~ /\G\e\[([\x30-\x3f]*)([\x20-\x2f]*)([\x40-\x7e])/gc) { csi($1, $2, $3); }
    elsif ($buf =~ /\G\e\](?:[^\a\e]|\e(?!\\))*(?:\a|\e\\)/gc) { }
    elsif ($buf =~ /\G\e[PX^_](?:[^\e]|\e(?!\\))*(?:\e\\)?/gc) { }
    elsif ($buf =~ /\G\e[\(\)]./gc) { }
    elsif ($buf =~ /\G\e\%./gc) { }
    elsif ($buf =~ /\G\e./gc) { }
    elsif ($buf =~ /\G(.)/sgc) { put($1); }
    else { last; }
}

commit_screen();
my @out = $alt ? (@pri_history, @history) : @history;
print join("\n", @out);
print "\n" if @out;
PERL
  then
    rm -f "$cleaned"
    die "cannot clean session log"
  fi
  cp "$cleaned" "$log" || die "cannot write $log"
  rm -f "$cleaned"
  chmod 600 "$log" 2>/dev/null || true
}

connect_with_log() {
  local name="$1" stamp raw log status=0 i=1
  command -v script >/dev/null 2>&1 || die "--log requires the script command"
  command -v perl >/dev/null 2>&1 || die "--log requires perl"
  mkdir -p "$LOG_DIR" || die "cannot create $LOG_DIR"
  chmod 700 "$LOG_DIR" 2>/dev/null || true
  stamp=$(date +%Y%m%d-%H%M%S)
  log="$LOG_DIR/${name}-${stamp}.log"
  while [ -e "$log" ]; do
    log="$LOG_DIR/${name}-${stamp}-$i.log"
    i=$((i + 1))
  done
  raw=$(mktemp "${TMPDIR:-/tmp}/macssh.XXXXXX") || die "cannot create temporary log"
  if size=$(stty size 2>/dev/null); then
    export LINES=${size% *}
    export COLUMNS=${size#* }
  fi
  printf "Logging to '%s'\n" "$log"
  if [ "$(uname -s)" = Linux ]; then
    if [ -n "${LINES:-}" ] && [ -n "${COLUMNS:-}" ]; then
      script -q -e -c "stty rows ${LINES} cols ${COLUMNS} 2>/dev/null; exec ssh $(printf '%q' "$name")" "$raw" || status=$?
    else
      script -q -e -c "ssh $(printf '%q' "$name")" "$raw" || status=$?
    fi
  else
    script -q "$raw" ssh "$name" || status=$?
  fi
  write_readable_log "$raw" "$log"
  rm -f "$raw"
  printf "Saved session log to '%s'\n" "$log"
  return "$status"
}

cmd_connect() {
  local name="" enable_log=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --log) enable_log=1; shift ;;
      --*) die "unknown option: $1" ;;
      *)
        [ -z "$name" ] || die "usage: macssh connect [name] [--log]"
        name="$1"
        shift
        ;;
    esac
  done
  if ! name=$(resolve_host "$name"); then
    return 1
  fi
  if [ "$enable_log" -eq 0 ]; then
    exec ssh "$name"
  fi
  connect_with_log "$name"
}

cmd_tunnel_start() {
  local name remote_port local_port="" bind_address="127.0.0.1" compress=0 state control tmp candidate
  [ "${1:-}" != "start" ] || shift
  [ $# -ge 2 ] || die "usage: macssh tunnel [start] <name> <remote-port> [--local LOCAL_PORT] [--bind ADDRESS] [--compress]"
  name="$1"
  remote_port="$2"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --local)
        [ $# -ge 2 ] || die "--local requires a port"
        local_port="$2"
        shift 2
        ;;
      --bind)
        [ $# -ge 2 ] || die "--bind requires an IPv4 address"
        bind_address="$2"
        shift 2
        ;;
      --compress) compress=1; shift ;;
      *) die "unknown tunnel option: $1" ;;
    esac
  done

  if ! name=$(resolve_host "$name"); then
    return 1
  fi
  validate_port "$remote_port"
  local_port=${local_port:-$remote_port}
  validate_port "$local_port"
  validate_ipv4 "$bind_address"
  init_tunnel_dir

  # A local listening port can only belong to one tunnel. Remove stale state
  # before reporting a conflict with another managed tunnel.
  for candidate in "$TUNNEL_DIR"/*.state; do
    [ -e "$candidate" ] || continue
    if ! read_tunnel_state "$candidate"; then
      rm -f "$candidate"
      continue
    fi
    if [ "$TUNNEL_LOCAL_PORT" = "$local_port" ]; then
      if tunnel_is_running "$TUNNEL_NAME" "$TUNNEL_CONTROL"; then
        die "local port $local_port is already used by tunnel '$TUNNEL_NAME'"
      fi
      rm -f "$candidate" "$TUNNEL_CONTROL"
    fi
  done

  state=$(tunnel_state_file "$name" "$local_port")
  control=$(tunnel_control_file "$name" "$local_port")
  # macOS limits Unix-domain socket paths. Fail with an actionable message
  # instead of exposing OpenSSH's less obvious "too long" error.
  [ ${#control} -lt 100 ] || die "tunnel path is too long; set MACSSH_TUNNEL_DIR to a shorter directory"
  if [ -e "$control" ]; then
    if tunnel_is_running "$name" "$control"; then
      die "a tunnel control socket already exists for '$name' on local port $local_port"
    fi
    rm -f "$control"
  fi

  tmp=$(mktemp "$TUNNEL_DIR/.state.XXXXXX") || die "cannot create tunnel state"
  {
    printf '%s\n' "$name"
    printf '%s\n' "$local_port"
    printf '%s\n' "$remote_port"
    printf '%s\n' "$control"
    printf '%s\n' "$bind_address"
  } > "$tmp" || { rm -f "$tmp"; die "cannot write tunnel state"; }
  chmod 600 "$tmp" 2>/dev/null || true

  if [ "$compress" -eq 1 ]; then
    ssh -M -S "$control" -f -N -T -C \
      -o ExitOnForwardFailure=yes -o ControlPersist=no \
      -L "${bind_address}:${local_port}:127.0.0.1:${remote_port}" "$name" \
      || { rm -f "$tmp" "$control"; die "cannot start tunnel"; }
  else
    ssh -M -S "$control" -f -N -T \
      -o ExitOnForwardFailure=yes -o ControlPersist=no \
      -L "${bind_address}:${local_port}:127.0.0.1:${remote_port}" "$name" \
      || { rm -f "$tmp" "$control"; die "cannot start tunnel"; }
  fi
  if ! mv "$tmp" "$state"; then
    ssh -S "$control" -O exit "$name" >/dev/null 2>&1 || true
    rm -f "$tmp" "$control"
    die "cannot save tunnel state"
  fi
  printf "Started tunnel '%s': %s:%s -> 127.0.0.1:%s\n" "$name" "$bind_address" "$local_port" "$remote_port"
}

cmd_tunnel_list() {
  local state count=0
  init_tunnel_dir
  printf '%-22s %-23s %-23s %s\n' HOST LOCAL REMOTE STATUS
  for state in "$TUNNEL_DIR"/*.state; do
    [ -e "$state" ] || continue
    if ! read_tunnel_state "$state"; then
      rm -f "$state"
      continue
    fi
    if tunnel_is_running "$TUNNEL_NAME" "$TUNNEL_CONTROL"; then
      printf '%-22s %-23s %-23s %s\n' "$TUNNEL_NAME" "$TUNNEL_BIND_ADDRESS:$TUNNEL_LOCAL_PORT" \
        "127.0.0.1:$TUNNEL_REMOTE_PORT" running
      count=$((count + 1))
    else
      rm -f "$state" "$TUNNEL_CONTROL"
    fi
  done
  [ "$count" -gt 0 ] || printf 'No active tunnels.\n'
}

stop_tunnel_state() {
  local state="$1"
  read_tunnel_state "$state" || { rm -f "$state"; die "invalid tunnel state: $state"; }
  if tunnel_is_running "$TUNNEL_NAME" "$TUNNEL_CONTROL"; then
    ssh -S "$TUNNEL_CONTROL" -O exit "$TUNNEL_NAME" >/dev/null \
      || die "cannot stop tunnel '$TUNNEL_NAME' on local port $TUNNEL_LOCAL_PORT"
    printf "Stopped tunnel '%s' on local port %s.\n" "$TUNNEL_NAME" "$TUNNEL_LOCAL_PORT"
  else
    printf "Removed stale tunnel '%s' on local port %s.\n" "$TUNNEL_NAME" "$TUNNEL_LOCAL_PORT"
  fi
  rm -f "$state" "$TUNNEL_CONTROL"
}

cmd_tunnel_stop() {
  local state found=0 name local_port
  init_tunnel_dir
  shift
  if [ "${1:-}" = "--all" ]; then
    [ $# -eq 1 ] || die "usage: macssh tunnel stop --all"
    for state in "$TUNNEL_DIR"/*.state; do
      [ -e "$state" ] || continue
      found=1
      stop_tunnel_state "$state"
    done
    [ "$found" -eq 1 ] || printf 'No active tunnels.\n'
    return
  fi

  [ $# -eq 2 ] || die "usage: macssh tunnel stop <name> <local-port>"
  name="$1"
  local_port="$2"
  validate_name "$name"
  validate_port "$local_port"
  state=$(tunnel_state_file "$name" "$local_port")
  [ -f "$state" ] || die "no managed tunnel for '$name' on local port $local_port"
  stop_tunnel_state "$state"
}

cmd_tunnel() {
  case "${1:-}" in
    list|ls) [ $# -eq 1 ] || die "usage: macssh tunnel list"; cmd_tunnel_list ;;
    stop|rm|kill) cmd_tunnel_stop "$@" ;;
    '') die "usage: macssh tunnel [start] <name> <remote-port> [--local LOCAL_PORT] [--bind ADDRESS]" ;;
    *) cmd_tunnel_start "$@" ;;
  esac
}

cmd_test() {
  [ $# -eq 1 ] || die "test requires a host name"
  local name
  name=$(resolve_host "$1")
  printf "Testing '%s'...\n" "$name"
  if ssh -o BatchMode=yes -o ConnectTimeout=5 "$name" true; then
    printf "Authentication succeeded for '%s'.\n" "$name"
  else
    die "authentication failed for '$name'"
  fi
}

cmd_put() {
  [ $# -ge 2 ] || die "put requires a host name and a local path"
  [ $# -le 3 ] || die "usage: macssh put <name> <local> [remote]"
  local name local_path remote_path dest
  name=$(resolve_host "$1")
  local_path="$2"
  remote_path="${3:-}"
  validate_value path "$local_path"
  validate_value path "$remote_path"
  [ -e "$local_path" ] || die "local path not found: $local_path"
  dest="$name:${remote_path:-}"
  printf "Uploading '%s' to '%s'\n" "$local_path" "$dest"
  if [ -d "$local_path" ]; then
    scp -r "$local_path" "$dest"
  else
    scp "$local_path" "$dest"
  fi
}

cmd_get() {
  [ $# -ge 2 ] || die "get requires a host name and a remote path"
  [ $# -le 3 ] || die "usage: macssh get <name> <remote> [local]"
  local name remote_path local_path
  name=$(resolve_host "$1")
  remote_path="$2"
  local_path="${3:-.}"
  validate_value path "$remote_path"
  validate_value path "$local_path"
  printf "Downloading '%s:%s' to '%s'\n" "$name" "$remote_path" "$local_path"
  scp -r "$name:$remote_path" "$local_path"
}

cmd_remove() {
  [ $# -eq 1 ] || die "remove requires a host name"
  init_config
  validate_name "$1"
  host_exists "$1" || die "unknown host: $1"
  printf "Remove '%s'? [y/N] " "$1" >&2
  IFS= read -r reply || true
  case "$reply" in y|Y|yes|YES) remove_block "$1"; printf "Removed '%s'.\n" "$1" ;; *) die "cancelled" ;; esac
}

cmd_config() {
  init_config
  local editor="${VISUAL:-${EDITOR:-vi}}"
  "$editor" "$CONFIG_FILE"
}

main() {
  local command="${1:-connect}"
  [ $# -eq 0 ] || shift
  case "$command" in
    add) cmd_add "$@" ;;
    list|ls) cmd_list "$@" ;;
    connect|ssh) cmd_connect "$@" ;;
    --log) cmd_connect --log "$@" ;;
    tunnel|port) cmd_tunnel "$@" ;;
    test) cmd_test "$@" ;;
    put|upload) cmd_put "$@" ;;
    get|download) cmd_get "$@" ;;
    edit) [ $# -eq 1 ] || die "edit requires a host name"; cmd_add "$1" --interactive ;;
    remove|rm) cmd_remove "$@" ;;
    config) cmd_config "$@" ;;
    path) init_config; printf '%s\n' "$CONFIG_FILE" ;;
    version|--version|-v) printf 'macssh %s\n' "$VERSION" ;;
    help|--help|-h) usage ;;
    *) die "unknown command: $command (run 'macssh help')" ;;
  esac
}

main "$@"
